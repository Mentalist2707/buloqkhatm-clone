// BuloqKhatm — Shaxsiy Qur'on Xatmi va Kitob O'qish Rejasi
// Prisma Schema v4 — Single-user (auth yo'q, rol yo'q)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum KhatmStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum KhatmType {
  GLOBAL
  PRIVATE
}

enum JuzStatus {
  AVAILABLE
  RESERVED
  COMPLETED
}

enum NotificationType {
  JUZ_DEADLINE
  KHATM_COMPLETED
  BOOK_DEADLINE
  BOOK_COMPLETED
  NEW_KHATM
  SYSTEM
}

enum BadgeType {
  KHATM_1
  KHATM_10
  KHATM_50
  KHATM_100
  KHATM_CREATOR_1
  KHATM_CREATOR_5
  KHATM_CREATOR_10
  STREAK_3
  STREAK_7
  STREAK_30
  STREAK_60
  STREAK_100
  BOOK_1
  BOOK_10
  BOOK_25
  BOOK_50
  JUZ_1
  JUZ_5
  JUZ_30
  JUZ_100
  PAGES_1
  PAGES_100
  PAGES_500
  PAGES_1000
  PAGES_5000
  PAGES_10000
  ACTIVE_30
  ACTIVE_100
  COINS_1000
  COINS_5000
}

/// BuloqCoin tranzaksiya sabablari
enum CoinReason {
  DAILY_ACTIVITY    // +5   — kunlik faollik
  PAGE_READ         // ichki — coin bermaydi
  JUZ_COMPLETED     // +25  — pora to'liq o'qildi
  KHATM_PARTICIPANT // +25  — xatm yakunlandi (ishtirokchi)
  KHATM_CREATOR     // +100 — xatm yaratuvchi bonus
  BOOK_COMPLETED    // +50  — kitob to'liq o'qildi
  STREAK_7          // +20  — 7 kun streak
  STREAK_30         // +50  — 30 kun streak
  ADMIN_BONUS       // qo'lda qo'shildi
  ADMIN_DEDUCT      // qo'lda ayirildi
}

enum BookStatus {
  READING     // o'qilmoqda
  COMPLETED   // yakunlangan
  PAUSED      // to'xtatilgan
}

// ─── User (bitta shaxsiy foydalanuvchi) ────────────────────────────────────────

model User {
  id         String  @id @default(cuid())

  username   String?
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  photoUrl   String? @map("photo_url")

  name          String?
  email         String?   @unique
  image         String?

  // BuloqCoin
  coins        Int     @default(0)
  level        String  @default("Beginner")
  streakDays   Int     @default(0)  @map("streak_days")
  lastActiveAt DateTime? @map("last_active_at")
  lastDailyAt  DateTime? @map("last_daily_at")

  // Statistika
  totalPagesRead Int @default(0) @map("total_pages_read")
  totalJuzRead   Int @default(0) @map("total_juz_read")
  totalKhatms    Int @default(0) @map("total_khatms")
  totalBooksRead Int @default(0) @map("total_books_read")

  country      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // App relations
  khatmsCreated   Khatm[]           @relation("KhatmCreator")
  participations  Participation[]
  juzAssigned     Juz[]             @relation("JuzAssignee")
  juzProgress     JuzProgress[]
  notifications   Notification[]
  badges          UserBadge[]
  coinHistory     CoinTransaction[]
  dailyActivities DailyActivity[]
  joinRequests    JoinRequest[]
  books           Book[]
  bookLogs        BookReadingLog[]

  @@map("users")
}

// ─── Khatm ────────────────────────────────────────────────────────────────────

model Khatm {
  id            String      @id @default(cuid())
  title         String
  description   String?     @db.Text
  status        KhatmStatus @default(DRAFT)
  type          KhatmType   @default(GLOBAL)
  isPrivate     Boolean     @default(false) @map("is_private")
  inviteCode    String?     @unique @map("invite_code")
  startDate     DateTime?   @map("start_date")
  endDate       DateTime?   @map("end_date")
  completedAt   DateTime?   @map("completed_at")
  createdById   String      @map("created_by_id")
  maxJuzPerUser Int         @default(2)     @map("max_juz_per_user")
  requireSequential Boolean @default(false) @map("require_sequential")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt      @map("updated_at")

  createdBy      User            @relation("KhatmCreator", fields: [createdById], references: [id])
  juzList        Juz[]
  participations Participation[]
  joinRequests   JoinRequest[]

  @@map("khatms")
}

// ─── Juz (Pora) ───────────────────────────────────────────────────────────────

model Juz {
  id           String    @id @default(cuid())
  khatmId      String    @map("khatm_id")
  juzNumber    Int       @map("juz_number")
  totalPages   Int       @default(20) @map("total_pages")
  status       JuzStatus @default(AVAILABLE)
  assignedToId String?   @map("assigned_to_id")
  reservedAt   DateTime? @map("reserved_at")
  deadline     DateTime?
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  khatm      Khatm        @relation(fields: [khatmId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation("JuzAssignee", fields: [assignedToId], references: [id])
  progress   JuzProgress?

  @@unique([khatmId, juzNumber])
  @@map("juz")
}

// ─── JuzProgress ─────────────────────────────────────────────────────────────

model JuzProgress {
  id         String   @id @default(cuid())
  juzId      String   @unique @map("juz_id")
  userId     String   @map("user_id")
  pagesRead  Int      @default(0) @map("pages_read")
  totalPages Int      @default(20) @map("total_pages")
  lastPageAt DateTime @default(now()) @map("last_page_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  juz  Juz  @relation(fields: [juzId],  references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("juz_progress")
}

// ─── DailyActivity ────────────────────────────────────────────────────────────

model DailyActivity {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  date        DateTime @db.Date
  pagesRead   Int      @default(0) @map("pages_read")
  juzRead     Int      @default(0) @map("juz_read")
  bookPages   Int      @default(0) @map("book_pages")
  coinsEarned Int      @default(0) @map("coins_earned")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_activities")
}

// ─── Participation ────────────────────────────────────────────────────────────

model Participation {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  khatmId  String   @map("khatm_id")
  joinedAt DateTime @default(now()) @map("joined_at")
  juzCount Int      @default(0)     @map("juz_count")

  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)
  khatm Khatm @relation(fields: [khatmId], references: [id], onDelete: Cascade)

  @@unique([userId, khatmId])
  @@map("participations")
}

// ─── JoinRequest ──────────────────────────────────────────────────────────────

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model JoinRequest {
  id        String            @id @default(cuid())
  userId    String            @map("user_id")
  khatmId   String            @map("khatm_id")
  status    JoinRequestStatus @default(PENDING)
  message   String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt      @map("updated_at")

  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)
  khatm Khatm @relation(fields: [khatmId], references: [id], onDelete: Cascade)

  @@unique([userId, khatmId])
  @@map("join_requests")
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType @default(SYSTEM)
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── BuloqCoin Transaction ────────────────────────────────────────────────────

model CoinTransaction {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  amount      Int
  reason      CoinReason
  description String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coin_transactions")
}

// ─── Badges ───────────────────────────────────────────────────────────────────

model Badge {
  id          String    @id @default(cuid())
  type        BadgeType @unique
  name        String
  description String
  icon        String
  requirement Int
  createdAt   DateTime  @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Book Reading Planner (Kitob o'qish rejasi) ────────────────────────────────

model Book {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")

  title       String                              // kitob nomi
  author      String?                             // muallif / egasi
  coverUrl    String?    @map("cover_url")         // muqova rasmi (URL yoki /uploads/..)
  description String?    @db.Text

  totalPages  Int        @map("total_pages")       // jami betlar soni
  currentPage Int        @default(0) @map("current_page") // hozirgi bet

  startDate   DateTime   @default(now()) @map("start_date")
  targetDays  Int        @map("target_days")       // necha kunda tugatish rejasi
  targetDate  DateTime?  @map("target_date")       // reja tugash sanasi (startDate + targetDays)
  completedAt DateTime?  @map("completed_at")
  pausedAt    DateTime?  @map("paused_at")         // to'xtatilgan vaqt (PAUSED bo'lganda)

  status      BookStatus @default(READING)

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt      @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs BookReadingLog[]

  @@index([userId, status])
  @@map("books")
}

/// Kitob o'qish tarixi — har bir o'qish yozuvi
model BookReadingLog {
  id        String   @id @default(cuid())
  bookId    String   @map("book_id")
  userId    String   @map("user_id")

  date      DateTime @default(now())               // o'qilgan sana/vaqt
  fromPage  Int      @map("from_page")             // qaysi betdan
  toPage    Int      @map("to_page")               // qaysi betgacha
  pagesRead Int      @map("pages_read")            // o'qilgan betlar (toPage - fromPage + 1)
  note      String?  @db.Text                       // ixtiyoriy izoh

  createdAt DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, date])
  @@index([userId, date])
  @@map("book_reading_logs")
}
